OPENROUTER_API_KEY=sk-or-v1-your-key-here
PORT=3000
# Optional: requests per minute per IP (all tiers / premium tiers)
RATE_LIMIT_PER_MIN=150
PREMIUM_LIMIT_PER_MIN=40

# Local models (Ollama). Installed models appear automatically as tiers, plus a "Hybrid" tier.
OLLAMA_URL=http://localhost:11434
OLLAMA_PARALLEL=1
# Google Gemini: adds a "Gemini" option to the model menus (GEMINI_MODEL is optional)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional extra OpenAI-compatible providers with your own free keys (inserted before the paid fallback)
# EXTRA1_NAME=groq
# EXTRA1_URL=https://api.groq.com/openai/v1
# EXTRA1_KEY=gsk_...
# EXTRA1_MODEL=llama-3.3-70b-versatile
# EXTRA2_NAME=gemini
# EXTRA2_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EXTRA2_KEY=...
# EXTRA2_MODEL=gemini-2.5-flash
